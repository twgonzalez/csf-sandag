# Exploration is never committed (project convention: no notebooks in main)
scratch/
*.ipynb

# Cached downloads and derived data are reproducible from code; do not commit
data/raw/
data/interim/
data/processed/
reports/

# Environment
.venv/

# Secrets. CENSUS_API_KEY lives here; it must never be committed. The pipeline runs without it
# (see docs/status.md, "Census API key") -- the key is a speed-up, never a correctness dependency.
.env
.env.*
!.env.example

# Private working materials: briefing drafts, meeting preparation, pre-publication archives.
# Never committed, never part of the public record. Note the limit of this protection: it
# guards git only -- a manual zip or copy of the working directory would still include it.
private/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
